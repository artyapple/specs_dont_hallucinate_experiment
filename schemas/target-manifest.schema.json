{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/specs-dont-hallucinate/target-manifest.schema.json",
  "title": "Canonical task formal target manifest",
  "type": "object",
  "required": ["$schema", "schemaVersion", "status", "formalPatchSha256", "files"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schemaVersion": {"const": 1},
    "status": {"enum": ["draft", "frozen"]},
    "formalPatchSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(api/openapi\\.yaml|db/queries/tasks\\.sql|db/migrations/[0-9]{6}_[a-z0-9_]+\\.sql)$"
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
