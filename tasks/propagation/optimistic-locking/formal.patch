diff --git a/db/migrations/000002_add_task_version.sql b/db/migrations/000002_add_task_version.sql
new file mode 100644
index 0000000..d5daffa
--- /dev/null
+++ b/db/migrations/000002_add_task_version.sql
@@ -0,0 +1,3 @@
+ALTER TABLE tasks
+ADD COLUMN version bigint NOT NULL DEFAULT 1,
+ADD CONSTRAINT tasks_version_positive CHECK (version > 0);
diff --git a/db/queries/tasks.sql b/db/queries/tasks.sql
